# Supabase frontend configuration only.
# A publishable key can be public when RLS and least-privilege grants are enabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# OPENAI_API_KEY must exist ONLY in Supabase Edge Function Secrets.
# Never put it in VITE_* variables, .env.local committed to GitHub, or frontend code.
# Optional backend model setting: OPENAI_MODEL=gpt-6-luna
